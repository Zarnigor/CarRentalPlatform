# Virtual environment — 9 574 files / 165 MB — must be excluded
.venv/

# VCS / editor
.git/
.gitignore
.idea/

# Python artefacts
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/

# Test / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Dev tooling
node_modules/
*.sqlite3

# Secrets — never in build context
.env
*.env.*

# Celery scheduler state (binary db file, grows on every beat tick)
celerybeat-schedule
celerybeat.pid

# Docker config itself (not needed inside the image)
docker/
